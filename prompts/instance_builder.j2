  },
  "image": {
    "name": "{{ instance_id | lower }}:latest",
    "archive": "image/{{ instance_id }}.tar.gz",
    "archive_format": "docker_save_tar_gzip",
    "load_command": "docker load -i"
  },
  "runtime": {
    "ready_check": "<shell readiness check>",
    "ready_timeout_seconds": 60,
    "entrypoint": "<optional absolute executable>",
    "command": ["<optional argument>", "<optional argument>"]
  },
  "task_files": {
    "public_problem_statement": "meta/description.md",
    "private_metadata": "meta/metadata.json",
    "reference_patch": "meta/gold_patch.diff",
    "fail_to_pass": ["harness/f2p.sh"],
    "pass_to_pass": ["harness/p2p.sh"]
  },
  "prompt_protocol": {
    "template": "prompts/misconfig_troubleshooting.j2",
    "case_prompt": "meta/description.md"
  },
  "builder_protocol": {
