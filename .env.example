# Copy this file to .env and fill in local values. Never commit .env.
# Runtime observability and limits
MISCONFIGBENCH_HEARTBEAT_SECONDS=30
MISCONFIGBENCH_AGENT_TIMEOUT_SECONDS=900
# OpenHands/LiteLLM transient-network retry settings
MISCONFIGBENCH_LLM_NUM_RETRIES=8
MISCONFIGBENCH_LLM_RETRY_MULTIPLIER=2
MISCONFIGBENCH_LLM_RETRY_MIN_WAIT_SECONDS=2
MISCONFIGBENCH_LLM_RETRY_MAX_WAIT_SECONDS=30
MISCONFIGBENCH_LLM_REQUEST_TIMEOUT_SECONDS=600
# Optional API-model prices in USD per million tokens. They are ignored for
# OpenAI subscription login, which records token usage but has no per-token bill.
MISCONFIGBENCH_LLM_INPUT_COST_PER_1M_TOKENS=
MISCONFIGBENCH_LLM_OUTPUT_COST_PER_1M_TOKENS=

# LLM authentication is selected explicitly by each VS Code launch entry.
# OpenAI subscription uses the local `openhands` login and needs no API key.
# OpenLux uses only the variables below; it does not reuse OpenAI credentials.
OPENLUX_API_KEY=
OPENLUX_API_URL=
OPENLUX_MODEL=

# Optional on non-macOS hosts. macOS system HTTP(S) proxy settings are used
# automatically when these variables are unset.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
