                     "--model", "gpt-5.6-luna", "--max-iterations", "30", "--agent-timeout", "900"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Builder: Validate existing instance",
            "type": "debugpy",
            "request": "launch",
            "python": "/Applications/miniconda3/envs/openhands/bin/python",
            "module": "agents.builder.run_case",
            "args": ["${input:instanceId}", "--validate-only", "--validation-timeout", "180"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ],
    "inputs": [
        {
            "id": "evidenceCondition", "type": "pickString",
            "description": "RQ3 frozen evidence condition",
            "options": ["full", "description_only", "key_only", "key_removed", "matched_control"],
            "default": "full"
        },
        {
            "id": "evidencePackDir", "type": "promptString",
            "description": "Directory containing reviewed <ID>.json evidence packs"
        },
        {
            "id": "observationsFile", "type": "promptString",
            "description": "Path to evidence_observations.jsonl"
        },
        {
            "id": "annotationOutput", "type": "promptString",
            "description": "New JSON output path (existing files are not overwritten)"
        },
        {
            "id": "evidenceReviewFile", "type": "promptString",
            "description": "Reviewed claim support JSON matching this diagnosis and ledger"
        },
        {
            "id": "diagnosisFile",
            "type": "promptString",
            "description": "Path to the saved diagnosis JSON for the selected case"
        },
        {
            "id": "diagnosisRunsDir",
            "type": "promptString",
            "description": "Runs directory to summarize (automatically grouped by provider/model)",
            "default": "${workspaceFolder}/runs"
        },
        {
            "id": "instanceId",
            "type": "promptString",
            "description": "MisconfigBench instance ID",
            "default": "CA14"
        }
    ]
}
