{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "RQ1: Troubleshooter batch (OpenAI Subscription)",
            "type": "debugpy",
            "request": "launch",
            "python": "/Applications/miniconda3/envs/openhands/bin/python",
            "module": "agents.evaluator.run_case",
            "args": [
                "--task", "troubleshooter", "--evidence-mode", "none",
                "--all", "--verify-timeout", "120",
                "--llm-provider", "openai_subscription", "--subscription-login",
                "--model", "gpt-5.6-luna",
                "--max-iterations", "30", "--agent-timeout", "900"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "RQ1: Troubleshooter batch (OpenLux API - Openai)",
            "type": "debugpy",
            "request": "launch",
            "python": "/Applications/miniconda3/envs/openhands/bin/python",
            "module": "agents.evaluator.run_case",
            "args": [
                "--task", "troubleshooter", "--evidence-mode", "none",
                "--all", "--verify-timeout", "120",
                "--llm-provider", "openlux",
                "--model", "gpt-5.6-luna",
                "--max-iterations", "30", "--agent-timeout", "900"
