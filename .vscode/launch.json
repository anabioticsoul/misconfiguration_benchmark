            "request": "launch",
            "python": "/Applications/miniconda3/envs/openhands/bin/python",
            "module": "agents.evaluator.annotations",
            "args": ["${input:instanceId}", "--output", "${input:annotationOutput}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "RQ3: Prepare evidence pack",
            "type": "debugpy",
            "request": "launch",
            "python": "/Applications/miniconda3/envs/openhands/bin/python",
            "module": "agents.evaluator.troubleshooter.evidence_pack",
            "args": ["${input:instanceId}", "--observations", "${input:observationsFile}",
                     "--output", "${input:annotationOutput}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "RQ3: Score human evidence review (offline)",
            "type": "debugpy",
            "request": "launch",
            "python": "/Applications/miniconda3/envs/openhands/bin/python",
            "module": "agents.evaluator.run_case",
            "args": ["--task", "troubleshooter", "${input:instanceId}",
                     "--diagnosis-file", "${input:diagnosisFile}",
                     "--evidence-mode", "collect", "--observations-file", "${input:observationsFile}",
                     "--evidence-review", "${input:evidenceReviewFile}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "RQ2/RQ3: Grouped report",
