            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Verifier: Consistency review (OpenAI Subscription)",
            "type": "debugpy",
            "request": "launch",
            "python": "/Applications/miniconda3/envs/openhands/bin/python",
            "module": "agents.verifier.run_case",
            "args": [
                "${input:instanceId}",
                "--llm-provider", "openai_subscription", "--subscription-login",
                "--model", "gpt-5.6-luna", "--max-iterations", "30", "--agent-timeout", "900"
            ],
