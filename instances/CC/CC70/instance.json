{
  "instance_id": "CC70",
  "benchmark": "MisconfigBench",
  "version": "0.2",
  "task_type": "misconfig_troubleshooting",
  "software": {
    "name": "Spring Boot",
    "version": "2.6.3"
  },
  "source": {
    "type": "Stack Overflow question",
    "url": "https://stackoverflow.com/questions/71176805"
  },
  "image": {
    "name": "cc70:latest",
    "archive": "image/CC70.tar.gz",
    "archive_format": "docker_save_tar_gzip",
    "load_command": "docker load -i",
    "distribution": {
      "type": "docker_registry",
      "reference": "docker.io/heliopolis0124/misconfigbench-cc70:v0.2",
      "digest": "sha256:9db661f99ea0b27b12a140a86f824d0d7ef518f7fd2a6a8a2fa198becd159832",
      "pull_reference": "docker.io/heliopolis0124/misconfigbench-cc70@sha256:9db661f99ea0b27b12a140a86f824d0d7ef518f7fd2a6a8a2fa198becd159832"
    }
  },
  "runtime": {
    "ready_check": "curl -sS -o /dev/null -w '%{http_code}' http://127.0.0.1:8080/vs1/users | grep -E '^(200|401)$'",
    "ready_timeout_seconds": 60,
    "entrypoint": "/bin/bash",
    "command": [
      "-lc",
      "exec java -jar /opt/app/target/login-register-0.0.1-SNAPSHOT.jar"
    ]
  },
  "task_files": {
    "public_problem_statement": "meta/description.md",
    "private_metadata": "meta/metadata.json",
    "reference_patch": "meta/gold_patch.diff",
    "fail_to_pass": [
      "harness/f2p.sh"
    ],
    "pass_to_pass": [
      "harness/p2p.sh"
    ]
  },
  "prompt_protocol": {
    "template": "prompts/misconfig_troubleshooting.j2",
    "case_prompt": "meta/description.md"
  },
  "builder_protocol": {
    "template": "prompts/instance_builder.j2",
    "spec": "build/build.json",
    "requirements": "build/requirements.md"
  },
  "evaluator_harness": {
    "visibility": "private",
    "reproduce": "harness/repro.sh",
    "fail_to_pass": [
      "harness/f2p.sh"
    ],
    "pass_to_pass": [
      "harness/p2p.sh"
    ],
    "delivery": "host_controlled_ephemeral_container"
  },
  "host_harness": {
    "evaluate_prediction": "harness/eval_patch.sh"
  },
  "patch_protocol": {
    "format": "unified_diff",
    "baseline_source": "fresh_faulty_container",
    "apply_workdir": "dynamic_host_staging_root",
    "apply_command": "git apply --unsafe-paths",
    "container_delivery": "copy_allowed_configuration_files_only"
  },
  "success_criteria": {
    "patch_applies": true,
    "evaluation_script_exit_code": 0,
    "only_allowed_files_modified": true,
    "required_configuration_option_modified": true
  }
}
