{
  "instance_id": "CA167",
  "benchmark": "MisconfigBench",
  "version": "0.2",
  "task_type": "misconfig_troubleshooting",
  "software": {
    "name": "Apache HTTP Server",
    "version": "2.4"
  },
  "source": {
    "type": "official_docker_image",
    "url": "https://hub.docker.com/_/ubuntu"
  },
  "image": {
    "name": "ca167:latest",
    "archive": "image/CA167.tar.gz",
    "archive_format": "docker_save_tar_gzip",
    "load_command": "docker load -i",
    "distribution": {
      "type": "docker_registry",
      "reference": "docker.io/heliopolis0124/misconfigbench-ca167:v0.2",
      "digest": "sha256:c05c34755da52fa213ad828e61d8fee6cad9c6065c57b3f53663132c525a4a6a",
      "pull_reference": "docker.io/heliopolis0124/misconfigbench-ca167@sha256:c05c34755da52fa213ad828e61d8fee6cad9c6065c57b3f53663132c525a4a6a"
    }
  },
  "runtime": {
    "ready_check": "test -x /usr/sbin/apache2 && test -f /etc/apache2/ports.conf",
    "ready_timeout_seconds": 60,
    "entrypoint": "/bin/bash",
    "command": [
      "-lc",
      "exec tail -f /dev/null"
    ]
  },
  "task_files": {
    "public_problem_statement": "meta/description.md",
    "private_metadata": "meta/metadata.json",
    "reference_patch": "meta/gold_patch.diff",
    "fail_to_pass": [
      "harness/f2p.sh"
    ],
    "pass_to_pass": [
      "harness/p2p.sh"
    ]
  },
  "prompt_protocol": {
    "template": "prompts/misconfig_troubleshooting.j2",
    "case_prompt": "meta/description.md"
  },
  "builder_protocol": {
    "template": "prompts/instance_builder.j2",
    "spec": "build/build.json",
    "requirements": "build/requirements.md"
  },
  "evaluator_harness": {
    "visibility": "private",
    "reproduce": "harness/repro.sh",
    "fail_to_pass": [
      "harness/f2p.sh"
    ],
    "pass_to_pass": [
      "harness/p2p.sh"
    ],
    "delivery": "host_controlled_ephemeral_container"
  },
  "host_harness": {
    "evaluate_prediction": "harness/eval_patch.sh"
  },
  "patch_protocol": {
    "format": "unified_diff",
    "baseline_source": "fresh_faulty_container",
    "apply_workdir": "dynamic_host_staging_root",
    "apply_command": "git apply --unsafe-paths",
    "container_delivery": "copy_allowed_configuration_files_only"
  },
  "success_criteria": {
    "patch_applies": true,
    "evaluation_script_exit_code": 0,
    "only_allowed_files_modified": true,
    "required_configuration_option_modified": true
  }
}
