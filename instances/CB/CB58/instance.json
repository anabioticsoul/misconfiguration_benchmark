{
  "instance_id": "CB58",
  "benchmark": "MisconfigBench",
  "version": "0.2",
  "task_type": "misconfig_troubleshooting",
  "software": {
    "name": "Apache HTTP Server",
    "version": "2.4.34 (Win32)"
  },
  "source": {
    "type": "Stack Overflow public question",
    "url": "https://stackoverflow.com/questions/1138269/apache-error-notice-parent-child-process-exited-with-status-3221225477-res"
  },
  "image": {
    "name": "cb58:latest",
    "archive": "image/CB58.tar.gz",
    "archive_format": "docker_save_tar_gzip",
    "load_command": "docker load -i",
    "distribution": {
      "type": "docker_registry",
      "reference": "docker.io/heliopolis0124/misconfigbench-cb58:v0.2",
      "digest": "sha256:96f9d92a2617120fd69b05a23af54d91f97bc873a8d908fdb88f826391a8d5c2",
      "pull_reference": "docker.io/heliopolis0124/misconfigbench-cb58@sha256:96f9d92a2617120fd69b05a23af54d91f97bc873a8d908fdb88f826391a8d5c2"
    }
  },
  "runtime": {
    "ready_check": "test -x /opt/apache/bin/httpd && test -f /opt/apache/modules/mod_stackprobe.so && test -f /opt/apache/conf/httpd.conf",
    "ready_timeout_seconds": 60,
    "entrypoint": "/bin/bash",
    "command": [
      "-lc",
      "exec tail -f /dev/null"
    ]
  },
  "task_files": {
    "public_problem_statement": "meta/description.md",
    "private_metadata": "meta/metadata.json",
    "reference_patch": "meta/gold_patch.diff",
    "fail_to_pass": [
      "harness/f2p.sh"
    ],
    "pass_to_pass": [
      "harness/p2p.sh"
    ]
  },
  "prompt_protocol": {
    "template": "prompts/misconfig_troubleshooting.j2",
    "case_prompt": "meta/description.md"
  },
  "builder_protocol": {
    "template": "prompts/instance_builder.j2",
    "spec": "build/build.json",
    "requirements": "build/requirements.md"
  },
  "evaluator_harness": {
    "visibility": "private",
    "reproduce": "harness/repro.sh",
    "fail_to_pass": [
      "harness/f2p.sh"
    ],
    "pass_to_pass": [
      "harness/p2p.sh"
    ],
    "delivery": "host_controlled_ephemeral_container"
  },
  "host_harness": {
    "evaluate_prediction": "harness/eval_patch.sh"
  },
  "patch_protocol": {
    "format": "unified_diff",
    "baseline_source": "fresh_faulty_container",
    "apply_workdir": "dynamic_host_staging_root",
    "apply_command": "git apply --unsafe-paths",
    "container_delivery": "copy_allowed_configuration_files_only"
  },
  "success_criteria": {
    "patch_applies": true,
    "evaluation_script_exit_code": 0,
    "only_allowed_files_modified": true,
    "required_configuration_option_modified": true
  }
}
