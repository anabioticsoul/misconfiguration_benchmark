{
  "instance_id": "CB113",
  "benchmark": "MisconfigBench",
  "version": "0.2",
  "task_type": "misconfig_troubleshooting",
  "software": {
    "name": "Java",
    "version": "OpenJDK 11"
  },
  "source": {
    "type": "Stack Overflow question",
    "url": "https://stackoverflow.com/questions/6582768/what-should-i-set-java-home-environment-variable-on-mac-os-x-10-6"
  },
  "image": {
    "name": "cb113:latest",
    "archive": "image/CB113.tar.gz",
    "archive_format": "docker_save_tar_gzip",
    "load_command": "docker load -i",
    "distribution": {
      "type": "docker_registry",
      "reference": "docker.io/heliopolis0124/misconfigbench-cb113:v0.2",
      "digest": "sha256:b6ff996f7b2378a4e2d867b3b30e30843c20307b5a62a4840a6cbcec79fd7e71",
      "pull_reference": "docker.io/heliopolis0124/misconfigbench-cb113@sha256:b6ff996f7b2378a4e2d867b3b30e30843c20307b5a62a4840a6cbcec79fd7e71"
    }
  },
  "runtime": {
    "ready_check": "test -f /etc/profile.d/java_home.sh",
    "ready_timeout_seconds": 60,
    "entrypoint": "/bin/bash",
    "command": [
      "-lc",
      "exec tail -f /dev/null"
    ]
  },
  "task_files": {
    "public_problem_statement": "meta/description.md",
    "private_metadata": "meta/metadata.json",
    "reference_patch": "meta/gold_patch.diff",
    "fail_to_pass": [
      "harness/f2p.sh"
    ],
    "pass_to_pass": [
      "harness/p2p.sh"
    ]
  },
  "prompt_protocol": {
    "template": "prompts/misconfig_troubleshooting.j2",
    "case_prompt": "meta/description.md"
  },
  "builder_protocol": {
    "template": "prompts/instance_builder.j2",
    "spec": "build/build.json",
    "requirements": "build/requirements.md"
  },
  "evaluator_harness": {
    "visibility": "private",
    "reproduce": "harness/repro.sh",
    "fail_to_pass": [
      "harness/f2p.sh"
    ],
    "pass_to_pass": [
      "harness/p2p.sh"
    ],
    "delivery": "host_controlled_ephemeral_container"
  },
  "host_harness": {
    "evaluate_prediction": "harness/eval_patch.sh"
  },
  "patch_protocol": {
    "format": "unified_diff",
    "baseline_source": "fresh_faulty_container",
    "apply_workdir": "dynamic_host_staging_root",
    "apply_command": "git apply --unsafe-paths",
    "container_delivery": "copy_allowed_configuration_files_only"
  },
  "success_criteria": {
    "patch_applies": true,
    "evaluation_script_exit_code": 0,
    "only_allowed_files_modified": true,
    "required_configuration_option_modified": true
  }
}
